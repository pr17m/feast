# Feast — India stack. Copy to in.env and change every password.
FEAST_COUNTRY=in
PORT=8082

# development = test payments, OTP code 123456 shown on screen, test-mode social login.
# Fine for trying it out with friends; use production with real keys for a launch.
FEAST_ENV=development

# Database — pick ONE:
#  (a) bundled Postgres inside this stack (default):
COMPOSE_PROFILES=db
POSTGRES_PASSWORD=change-me-postgres
#  (b) a Postgres you already run on this machine: comment out the two lines
#      above and set (host.docker.internal = "this computer" from inside Docker)
# DATABASE_URL=postgres://postgres:postgres@host.docker.internal:5432/feast
JWT_SECRET=change-me-to-a-long-random-string-0123456789
# Password for the seeded owner/admin accounts (admin@feast.demo, ...). Change it before sharing!
SEED_PASSWORD=change-me-admin

# Real payments (leave empty to keep test payments):
# PAYMENTS_FORCE_PROVIDER=
# RAZORPAY_ENABLED=true
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=...
# Webhooks (optional extra safeguard; register https://<site>/v1/webhooks/payments/<provider>):
# STRIPE_WEBHOOK_SECRET=whsec_...
# RAZORPAY_WEBHOOK_SECRET=...

# Dish photos: owners upload their own. For dishes without one, Feast can add a
# matching stock photo from Unsplash (free: create an app at unsplash.com/developers
# and paste its Access Key). Leave empty to show generated art instead.
# STOCK_PHOTOS_PROVIDER=unsplash
# UNSPLASH_ACCESS_KEY=

# Policy pages (/legal/terms, privacy, refunds, contact). Shown as placeholders with a
# "draft" notice until set; set FEAST_LEGAL_REVIEWED=true once a lawyer has approved the text.
# FEAST_LEGAL_NAME=Feast Dining Private Limited
# FEAST_LEGAL_ID=CIN U00000KA2026PTC000000
# FEAST_LEGAL_ADDRESS=1 Example Road, Bengaluru 560001
# FEAST_SUPPORT_EMAIL=help@feast.example
# FEAST_SUPPORT_PHONE=
# FEAST_PRIVACY_EMAIL=privacy@feast.example
# Required in India (Consumer Protection (E-Commerce) Rules, 2020): name and contact.
# FEAST_GRIEVANCE_OFFICER=Name Surname, grievance@feast.example
# FEAST_GOVERNING_LAW=Karnataka, India
# FEAST_LEGAL_UPDATED=2026-10-25
# FEAST_LEGAL_REVIEWED=false
